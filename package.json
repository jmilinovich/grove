{
  "name": "grove",
  "version": "1.0.0",
  "description": "A hosted knowledge API that makes Obsidian vaults searchable and writable from any MCP client.",
  "type": "module",
  "bin": {
    "grove": "./bin/grove"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jmilinovich/grove.git"
  },
  "homepage": "https://grove.md",
  "author": "John Milinovich",
  "license": "MIT",
  "keywords": [
    "obsidian",
    "mcp",
    "knowledge-base",
    "model-context-protocol",
    "search",
    "ai",
    "knowledge-management",
    "personal-knowledge"
  ],
  "scripts": {
    "proxy": "tsx src/proxy.ts",
    "keys": "tsx src/keys.ts",
    "grove": "tsx src/cli.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit/",
    "test:int": "vitest run test/integration/",
    "test:smoke": "bats test/smoke/*.bats",
    "test:eval": "tsx scripts/eval-vector-search.ts",
    "iterate": "tsx scripts/iterate.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run check:invariants && npm test",
    "check:plan": "tsx scripts/check-plan-drift.ts",
    "check:invariants": "tsx scripts/check-invariants.ts",
    "check:cache-version": "tsx scripts/check-cache-version.ts",
    "ship": "tsx scripts/ship.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}

{
  "name": "grove",
  "version": "1.0.0",
  "description": "Single-user MCP server over a git-backed Obsidian vault. Six tools — query, get, multi_get, write_note, list_notes, vault_status.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmilinovich/grove.git"
  },
  "author": "John Milinovich",
  "license": "MIT",
  "keywords": [
    "obsidian",
    "mcp",
    "knowledge-base",
    "model-context-protocol",
    "search",
    "ai",
    "knowledge-management",
    "personal-knowledge"
  ],
  "scripts": {
    "start": "tsx src/server.ts",
    "discovery": "tsx src/discovery-worker.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.10.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
